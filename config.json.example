## config.json for grengate EXAMPLE
## remove all comments, use proper values!
{
	## HomeKit pairing config, pin is important (need to enter it, 8 digits), setup id less  important (4 cap. chars)
	"HkPin": "12344321",
	"HkSetupId": "ABCD",

	## grenton gate ip and paths
	"Host": "http://192.168.0.1/",
	"ReadPath": "read/",
	"SetLightPath": "set/",

	## every how many seconds all devices are read from the GATE (default 10)
	"CycleInSeconds": 10,
	## devices per read request (default 30)
	"QueryLimit": 30,

	## minimum time between reads of a thermostat (default 60); thermostats not read yet are read every cycle
	"ThermoCycleInSeconds": 60,

	## write protocol: false (default) sends batched array requests with partial thermostat commands
	## and needs the new grenton/update-script.lua on the GATE; true sends one single-object request
	## per command with three-field thermostat commands (old script; the new script accepts it too)
	"LegacyWriteScript": false,
	## commands per write request (default 5) and batching window in ms (default 30);
	## grouping only, both ignored when LegacyWriteScript is true
	"SetterQueueSize": 5,
	"SetterFlushMs": 30,

	## no longer used; still accepted so older config files load
	"FreshInSeconds": 5,

	## optional: metrics to InfluxDB v2 (off when the block is missing or Enabled is false)
	"InfluxDB": {
		"Enabled": false,
		"URL": "http://localhost:8086",
		"Token": "your-token",
		"Org": "your-org",
		"Bucket": "grengate"
	},

	## define clus and devices here
	"Clus": [
		{
			"Id": "CLU_012abcde",
			"Name": "clu one",
			"Lights": [
				{
					"Id": 1234,
					"Kind": "DOU",
					"Name": "Light x"
				},
				{
					"Id": 4321,
					"Kind": "DOU",
					"Name": "Light other"
				},
				## optional HkType: "Lightbulb" (default) or "Outlet" - same DOUT, shown in HomeKit as power outlet
				{
					"Id": 5678,
					"Kind": "DOU",
					"Name": "Desk socket",
					"HkType": "Outlet"
				}
			],
			"Therms": [
				{
					"Id": 7788,
					"Kind": "THE",
					"Name": "Thermo ABC",
					"Source": "sensor_var"
				}
			]
		},		
		{
			"Id": "CLU110000123",
			"Name": "clu two",
			"Lights": [
				{
					"Id": 4321,
					"Kind": "DOU",
					"Name": "Light other"
				}
			]
		}
	]
}